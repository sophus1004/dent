# DENT 설정 예시. 필요한 값만 쓴다: cp .env.example .env 뒤 쓸 줄의 #을 지운다.
# 설정 파일이 없어도 실행된다(내장 DB · 포트 8000). .env는 커밋하지 않는다. 항목 설명은 README.md의 "설정 값".

# DB. 비워 두면 내장 DB(PostgreSQL + pgvector)를 storage/pgdata에 만들어 쓰고, 실행할 때 테이블도 스스로 올린다.
# 따로 된 PostgreSQL(pgvector 확장 필요)을 쓰려면 주소를 적는다. 그때 테이블은 uv run alembic upgrade head로 올린다.
# DATABASE_URL=postgresql+asyncpg://dent:change-me@127.0.0.1:5432/dent

# 테스트 전용 DB(개발자용). 비워 두면 테스트가 임시 내장 DB를 실행해서 쓴다. DATABASE_URL과 반드시 달라야 한다.
# TEST_DATABASE_URL=postgresql+asyncpg://dent:change-me@127.0.0.1:5432/dent_test

# 파일 루트. 상대 경로면 프로젝트 루트 기준이다. 내장 DB도 이 안(pgdata)에 둔다.
# STORAGE_DIR=./storage

# 화면 주소의 포트. 주소는 127.0.0.1로 고정이라 설정이 없다.
# PORT=8000

# 외부 모델 서버(임베딩 · Jev · LLM) 연결은 여기에 적지 않는다.
# 화면의 [연결 설정]에서 저장하고(system_connections), 다시 실행하지 않아도 바로 쓴다.

# 내장 모델(임베딩 · Jev)은 여기에 적지 않는다. uv run dent가 실행할 때 올릴 곳(GPU · CPU · 올리지 않음)과
# 파일(받기 · 이 PC의 폴더)을 묻고 다음에도 그대로 쓴다. 내장 모델은 PORT 다음 두 포트(PORT+1 · PORT+2)를 쓴다.

# 허깅페이스 토큰. 비공개·동의가 필요한 데이터셋을 가져올 때만 넣는다.
# HF_TOKEN=

# LOG_LEVEL=INFO
